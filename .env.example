# Copy this file to .env and fill in the values you need.
# docker-compose automatically loads .env from the project root.

# ── ISO source ───────────────────────────────────────────────────────────────
# Direct URL to download the Windows ISO.
# Leave unset if you prefer to mount a local ISO at ./input/windows.iso
WINDOWS_ISO_URL=

# ── Output ───────────────────────────────────────────────────────────────────
# Name of the output ISO file (without .iso extension)
OUTPUT_NAME=Windows-Unattended

# ── SMB network share (optional) ─────────────────────────────────────────────
# Leave SMB_HOST empty to skip the upload step.
SMB_HOST=
SMB_SHARE=
SMB_USER=
SMB_PASSWORD=
# Optional subdirectory inside the share (e.g. windows)
SMB_DIR=
